generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Application {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  // Step 1: Basic Info
  name            String
  fatherName      String
  address         String
  gender          String
  phone           String
  email           String
  
  // Step 2: Academic Info
  academicClass   String
  yearSemester    String
  rollNo          String
  collegeName     String
  universityName  String
  duration        String
  domain          String
  
  // Payment Info (Step 3 stores details)
  amount          Float
  paymentStatus   String   @default("PENDING")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}



model Admission {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId

  // Personal Info
  fullName        String
  address         String
  whatsappNo      String
  email           String
  fatherName      String
  fatherContact   String
  dob             String
  gender          String
  aadharCard      String

  // Academic Info
  academicClass   String
  semester        String
  rollNo          String
  college         String
  course          String
  postCode        String

  // Registration
  registrationNo  String   @unique
  collegeCode     String

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // rollNo must be unique per college (same roll number can exist in different colleges)
  @@index([rollNo, college])
}



enum BatchType {
  ONLINE
  OFFLINE
  HYBRID
}

enum BatchStatus {
  UPCOMING
  ONGOING
  FULL
  COMPLETED
}

model Batch {
  id           String      @id @default(auto()) @map("_id") @db.ObjectId

  name         String                  // e.g. "Batch A – Morning"
  course       String                  // e.g. "Full Stack Development"
  batchType    BatchType               // ONLINE | OFFLINE | HYBRID
  instructor   String?

  startDate    String                  // stored as "YYYY-MM-DD" string for simplicity
  endDate      String
  timingStart  String                  // "09:00"
  timingEnd    String                  // "11:00"
  days         String[]                // ["Mon", "Wed", "Fri"]

  totalSeats   Int
  bookedSeats  Int         @default(0) // incremented on each booking

  status       BatchStatus @default(UPCOMING)
  description  String?

  bookings     BookedSeat[]

  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([course, status])
}

model BookedSeat {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId

  // Student info — no prior admission required
  fullName    String
  whatsappNo  String
  email       String
  college     String

  batchId     String   @db.ObjectId
  batch       Batch    @relation(fields: [batchId], references: [id])

  createdAt   DateTime @default(now())

  // One student (by email) can book only one seat per batch
  @@unique([email, batchId])
  @@unique([whatsappNo, batchId])
  @@index([batchId])
}
